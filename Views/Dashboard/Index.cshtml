@model KeepSafe.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Site Header -->
<header class="site-header">
    <div class="site-header-inner">
        <a asp-action="Index" asp-controller="Dashboard" class="logo-link">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2.5" stroke-linecap="square">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="M9 12l2 2 4-4"/>
            </svg>
            <span class="logo-text">KEEPSAFE</span>
        </a>

        <div class="user-nav">
            <span class="nav-email">@Model.UserEmail</span>
            <form asp-action="Logout" asp-controller="Account" method="post" style="display: inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm">LOG OUT</button>
            </form>
        </div>
    </div>
</header>

<main class="main-content">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-banner" role="status">
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <!-- Stat Cards Section -->
    <div class="stats-grid">
        <div class="stat-card border-box">
            <div class="stat-label">TOTAL WARRANTIES</div>
            <div class="stat-value">@Model.TotalCount</div>
        </div>

        <div class="stat-card border-box stat-card-active">
            <div class="stat-label">ACTIVE WARRANTIES</div>
            <div class="stat-value">@Model.ActiveCount</div>
        </div>

        <div class="stat-card border-box">
            <div class="stat-label">EXPIRED WARRANTIES</div>
            <div class="stat-value">@Model.ExpiredCount</div>
        </div>
    </div>

    <!-- Warranties Section Header -->
    <div class="section-header">
        <h2 class="section-title">YOUR WARRANTIES</h2>
        <button type="button" class="btn btn-primary" id="openAddWarrantyBtn">+ ADD WARRANTY</button>
    </div>

    <!-- Warranties List / Empty State -->
    @if (Model.Warranties.Count == 0)
    {
        <div class="empty-state">
            <svg class="empty-state-svg" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <line x1="9" y1="9" x2="15" y2="15"/>
                <line x1="15" y1="9" x2="9" y2="15"/>
            </svg>
            <h3>NO WARRANTIES YET</h3>
            <p>Store your first warranty document or receipt securely in KeepSafe.</p>
            <button type="button" class="btn btn-primary" id="emptyStateAddWarrantyBtn">+ ADD YOUR FIRST WARRANTY</button>
        </div>
    }
    else
    {
        <div class="warranties-grid">
            @foreach (var item in Model.Warranties)
            {
                <div class="warranty-card border-box">
                    <div>
                        <div class="warranty-card-top">
                            <h3 class="warranty-title" title="@item.ProductName">@item.ProductName</h3>
                            @if (item.IsExpired)
                            {
                                <span class="badge badge-expired">EXPIRED</span>
                            }
                            else
                            {
                                <span class="badge badge-active">ACTIVE</span>
                            }
                        </div>

                        <div class="warranty-meta">
                            <div><strong>EXPIRES:</strong> @item.FormattedExpirationDate</div>
                            <div><strong>FILE:</strong> @item.OriginalFileName</div>
                            <div><strong>SIZE:</strong> @((item.FinalPdfSize / 1024.0).ToString("0.0")) KB</div>
                        </div>
                    </div>

                    <div class="warranty-actions">
                        <a href="@Url.Action("Document", "Warranties", new { id = item.Id })" target="_blank" rel="noopener noreferrer" class="btn btn-sm">VIEW</a>
                        <a href="@Url.Action("Document", "Warranties", new { id = item.Id, download = true })" class="btn btn-sm">DOWNLOAD</a>
                        <button type="button" class="btn btn-sm btn-danger btn-delete-warranty" data-id="@item.Id" data-name="@item.ProductName">DELETE</button>
                    </div>
                </div>
            }
        </div>
    }
</main>

<!-- Delete Confirmation Modal -->
<div class="modal-overlay" id="deleteConfirmModal" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle">
    <div class="modal-dialog panel-box" style="max-width: 420px;">
        <div class="modal-header">
            <h3 class="modal-title" id="deleteModalTitle">DELETE WARRANTY?</h3>
            <button type="button" class="modal-close-btn" id="closeDeleteModal" aria-label="Close modal">&times;</button>
        </div>

        <p style="font-family: 'Space Grotesk', sans-serif; font-size: 15px; margin-bottom: 16px;">
            The document will be permanently removed.
        </p>

        <form id="deleteWarrantyForm" method="post" action="">
            @Html.AntiForgeryToken()
            <div style="display: flex; gap: 12px; margin-top: 24px;">
                <button type="button" class="btn" style="flex: 1;" id="btnCancelDelete">CANCEL</button>
                <button type="submit" class="btn btn-danger" style="flex: 1;">DELETE</button>
            </div>
        </form>
    </div>
</div>

<!-- Include Add Warranty Modal Partial -->
<partial name="../Warranties/_AddWarrantyModal" />

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    <script src="~/js/add-warranty.js" asp-append-version="true"></script>
}
